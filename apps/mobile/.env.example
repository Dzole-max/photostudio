# Copy to .env and fill in. Load with: flutter run --dart-define-from-file=.env
# Every key is optional: empty values switch that service to its fake.

# Supabase project (EU region). Empty = local fake backend (auth, AI, geo, print).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Stripe publishable key (pk_test_... for test mode). Empty = fake payments.
STRIPE_PUBLISHABLE_KEY=
# RevenueCat public SDK keys for digital unlocks (stub).
REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=
# Crash reporting and analytics; both are no-ops when empty.
SENTRY_DSN=
POSTHOG_KEY=
# Bonus features. true shows the (fake-provider) flow, false shows "Coming soon".
# Living Memories and Illustrated default to true in the dev entrypoint when unset.
FEATURE_GUEST_LENS=false
FEATURE_LIVING_MEMORIES=true
FEATURE_ILLUSTRATED=true
FEATURE_GIFT_MODE=false
# auto = fake when a key is empty; true = always fake
USE_FAKES=auto
