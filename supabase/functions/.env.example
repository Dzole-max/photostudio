# Server-side configuration. Never ship these to the app.
# Every provider defaults to its fake so local development needs no accounts.

# LLM for captions, occasion and rewrite: fake | anthropic | google | openai
LLM_PROVIDER=fake
LLM_API_KEY=
# Model name is configuration, never hard-coded.
LLM_MODEL=
# Illustrated Edition style transfer: fake | fal | replicate
IMAGE_STYLE_PROVIDER=fake
IMAGE_STYLE_API_KEY=
# Living Memories hero motion
MOTION_PROVIDER=fake
MOTION_API_KEY=
# Reverse geocoding
GEO_PROVIDER=fake
GEO_API_KEY=
# Print fulfilment: fake | gelato
PRINT_PROVIDER=fake
GELATO_API_KEY=
# Stripe (test mode keys start with sk_test_ / whsec_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Render service location and shared bearer token
RENDER_SERVICE_URL=http://localhost:8080
RENDER_SERVICE_TOKEN=
# Supabase service role key (server only)
SUPABASE_SERVICE_ROLE_KEY=
